[Unit]
Description=DXFER full editing Dev playground
After=network.target

[Service]
Type=simple
User=ryan
WorkingDirectory=/home/ryan/dxfer-runtime/dev-publish
ExecStart=/home/ryan/dxfer-runtime/dev-publish/DXFER.Web
Restart=on-failure
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5175
Environment=HOME=/home/ryan/dxfer-runtime/dev-state
Environment=Dxfer__EnableFullEditing=true
Environment=Dxfer__EnableSyncIntegration=false
Environment=Dxfer__ApplicationName=DXFER-Dev-Playground
Environment=Dxfer__DataProtectionDirectory=/home/ryan/dxfer-runtime/dev-state/keys
EnvironmentFile=/home/ryan/dxfer-runtime/dev-state/runtime.env
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ryan/dxfer-runtime/dev-state
SyslogIdentifier=dxfer-dev

[Install]
WantedBy=multi-user.target
