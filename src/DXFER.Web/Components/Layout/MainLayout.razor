@inherits LayoutComponentBase
@implements IDisposable
@using DXFER.Blazor.Components
@using DXFER.Core.Sync
@using DXFER.Core.Sketching
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Reflection
@inject NavigationManager Navigation
@inject WorkbenchMenuCommandService MenuCommands
@inject IConfiguration Configuration
@inject ISketchSolver SketchSolver

<div class="page">
    <header class="app-header">
        <div class="@AppMenuClass" @onpointerleave="CloseAppMenu">
            <button type="button" class="app-menu-toggle" aria-label="Open application menu" title="Application menu" @onclick="ToggleAppMenu">
                <CadIcon Name="CadIconName.Menu" />
            </button>
            <nav class="app-menu-panel" aria-label="Application menu">
                <div class="app-menu-group">
                    <button type="button" class="app-menu-item app-menu-parent">
                        <span>File</span>
                        <span class="app-menu-arrow" aria-hidden="true">></span>
                    </button>
                    <div class="app-submenu" role="menu">
                        @if (Configuration.GetValue<bool>("Dxfer:EnableFullEditing"))
                        {
                            <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.NewBlankDocument)">New drawing</button>
                        }
                        <label class="app-menu-command app-menu-file-command">
                            <span>Open local DXF/DWG...</span>
                            <InputFile @key="_fileInputKey" OnChange="OpenHeaderFileAsync"
                                       accept=".dxf,.dwg"
                                       class="app-menu-file-input" />
                        </label>
                        @if (EnableSyncIntegration)
                        {
                            <button type="button" class="app-menu-command" @onclick="OpenSyncConnectDialog">Connect to Sync...</button>
                        }
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.SaveDxf)">Download DXF</button>
                        <button type="button" class="app-menu-command" @onclick="OpenAppearances">Appearances</button>
                        <button type="button" class="app-menu-command" @onclick="OpenSettings">Settings</button>
                        @if (IsSyncLaunch)
                        {
                            <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.SendToSync)">Save to Sync</button>
                        }
                    </div>
                </div>
                <div class="app-menu-group">
                    <button type="button" class="app-menu-item app-menu-parent">
                        <span>Cleanup</span>
                        <span class="app-menu-arrow" aria-hidden="true">></span>
                    </button>
                    <div class="app-submenu" role="menu">
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.RemoveDuplicates)">Remove duplicates</button>
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.Rotate90Clockwise)">Rotate 90 CW</button>
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.Rotate90CounterClockwise)">Rotate 90 CCW</button>
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.BoundsToOrigin)">Bounds to origin</button>
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.PointToOrigin)">Point to origin</button>
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.VectorToX)">Vector to X</button>
                        <button type="button" class="app-menu-command" @onclick="() => InvokeMenuCommand(WorkbenchCommandId.VectorToY)">Vector to Y</button>
                    </div>
                </div>
                <button type="button" class="app-menu-item" @onclick="OpenHotkeyOptions">Hotkeys</button>
            </nav>
        </div>
        <div class="app-brand" title="@BuildTitle">
            <div class="app-title">DXFER</div>
        </div>
        <div class="document-header" role="group" aria-label="Document state" aria-live="polite" aria-atomic="true">
            <span class="document-filename" title="@DocumentFileName">@DocumentFileName</span>
            <span class="document-units" title="@DocumentUnits">@DocumentUnits</span>
            <span class="document-change-state">@DocumentChangeState</span>
            <span class="document-access-state">@(DocumentState.HasDocument && DocumentState.IsReferenceOnly ? "Read-only" : string.Empty)</span>
        </div>
    </header>

    <main class="app-main">
        <article class="content">
            @Body
        </article>
    </main>
</div>

@if (_isSyncConnectOpen)
{
    <div class="app-modal-backdrop" @onclick="CloseSyncConnectDialog">
        <section class="app-modal-card" role="dialog" aria-modal="true" aria-labelledby="sync-connect-title" @onclick:stopPropagation="true">
            <header class="app-modal-header">
                <h2 id="sync-connect-title">Connect to Sync</h2>
                <button type="button" class="app-modal-close" aria-label="Close" title="Close" @onclick="CloseSyncConnectDialog"><CadIcon Name="CadIconName.Close" /></button>
            </header>
            <div class="app-modal-body">
                <label class="app-field">
                    <span>Sync DXFER launch link</span>
                    <input type="url"
                           value="@_syncConnectUrl"
                           @oninput="OnSyncConnectUrlInput"
                           @onkeydown="HandleSyncConnectKeyDown"
                           placeholder="https://sync.harrisonmetals.com/api/engineering/artifact/123/dxfer-launch" />
                </label>
                @if (!string.IsNullOrWhiteSpace(_syncConnectError))
                {
                    <div class="app-field-error">@_syncConnectError</div>
                }
            </div>
            <footer class="app-modal-actions">
                <button type="button" class="app-secondary-action" @onclick="CloseSyncConnectDialog">Cancel</button>
                <button type="button" class="app-primary-action" @onclick="ConnectToSyncAsync">Connect</button>
            </footer>
        </section>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error" title="Dismiss error"><CadIcon Name="CadIconName.Close" /></button>
</div>

<ToolHotkeyOptions IsOpen="_isHotkeyOptionsOpen" OnClose="CloseHotkeyOptions" />
<CanvasAppearance IsOpen="_isAppearancesOpen" OnClose="CloseAppearances" />
<WorkbenchSettings IsOpen="_isSettingsOpen" OnClose="CloseSettings" />

@code {
    private bool _isAppMenuOpen;
    private int _fileInputKey;
    private bool _isHotkeyOptionsOpen;
    private bool _isAppearancesOpen;
    private bool _isSettingsOpen;
    private void OpenSettings() { _isAppMenuOpen = false; _isSettingsOpen = true; }
    private void CloseSettings() => _isSettingsOpen = false;
    private void OpenAppearances() { _isAppMenuOpen = false; _isAppearancesOpen = true; }
    private void CloseAppearances() => _isAppearancesOpen = false;
    private bool _isSyncConnectOpen;
    private string _syncConnectUrl = string.Empty;
    private string? _syncConnectError;

    private string AppMenuClass => _isAppMenuOpen ? "app-menu app-menu-open" : "app-menu";

    private bool IsSyncLaunch => MenuCommands.HasSyncDocument;
    private bool EnableSyncIntegration => Configuration.GetValue("Dxfer:EnableSyncIntegration", true);
    private WorkbenchDocumentState DocumentState => MenuCommands.DocumentState;
    private string DocumentFileName => !DocumentState.HasDocument ? "No document"
        : string.IsNullOrWhiteSpace(DocumentState.FileName) ? "Untitled" : DocumentState.FileName;
    private string DocumentUnits => !DocumentState.HasDocument ? string.Empty
        : string.IsNullOrWhiteSpace(DocumentState.Units) ? "Unspecified" : DocumentState.Units;
    private string DocumentChangeState => !DocumentState.HasDocument ? string.Empty
        : DocumentState.HasUnsavedChanges ? "Modified" : "Unchanged";
    private static readonly string BuildIdentity = GetBuildTitle();
    private string BuildTitle => $"{BuildIdentity}; sketch solver: {SolverIdentity}";
    private string SolverIdentity => SketchSolver switch
    {
        PlaneGcsSketchSolverAdapter => "PlaneGCS",
        LegacySketchSolverAdapter => "Legacy",
        null => "Unavailable",
        _ => SketchSolver.GetType().Name
    };

    private static string GetBuildTitle()
    {
        var version = typeof(MainLayout).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        if (string.IsNullOrWhiteSpace(version)) return "DXFER";
        var metadata = version.IndexOf('+');
        var revision = metadata >= 0 ? version[(metadata + 1)..].Split('.')[0] : string.Empty;
        return revision.Length >= 7 && revision.All(Uri.IsHexDigit)
            ? $"DXFER build {revision[..7]}"
            : $"DXFER build {version}";
    }

    protected override void OnInitialized()
    {
        MenuCommands.HotkeyOptionsRequested += OpenHotkeyOptions;
        MenuCommands.SyncDocumentChanged += OnSyncDocumentChanged;
        MenuCommands.DocumentStateChanged += OnDocumentStateChanged;
    }

    public void Dispose()
    {
        MenuCommands.HotkeyOptionsRequested -= OpenHotkeyOptions;
        MenuCommands.SyncDocumentChanged -= OnSyncDocumentChanged;
        MenuCommands.DocumentStateChanged -= OnDocumentStateChanged;
    }

    private void OnSyncDocumentChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnDocumentStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleAppMenu() => _isAppMenuOpen = !_isAppMenuOpen;

    private void CloseAppMenu() => _isAppMenuOpen = false;

    private void OpenHotkeyOptions()
    {
        _isAppMenuOpen = false;
        _isHotkeyOptionsOpen = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void CloseHotkeyOptions() => _isHotkeyOptionsOpen = false;

    private void OpenSyncConnectDialog()
    {
        _isAppMenuOpen = false;
        _syncConnectError = null;
        _isSyncConnectOpen = true;
    }

    private void CloseSyncConnectDialog()
    {
        _isSyncConnectOpen = false;
        _syncConnectError = null;
    }

    private void OnSyncConnectUrlInput(ChangeEventArgs args)
    {
        _syncConnectUrl = args.Value?.ToString() ?? string.Empty;
        _syncConnectError = null;
    }

    private async Task HandleSyncConnectKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            await ConnectToSyncAsync();
        }
        else if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            CloseSyncConnectDialog();
        }
    }

    private Task ConnectToSyncAsync()
    {
        var value = _syncConnectUrl.Trim();
        if (string.IsNullOrWhiteSpace(value))
        {
            _syncConnectError = "Paste the launch link generated from Sync.";
            return Task.CompletedTask;
        }

        string target;
        if (Uri.TryCreate(value, UriKind.Absolute, out var absoluteUri))
        {
            target = absoluteUri.ToString();
        }
        else if (value.StartsWith("/", StringComparison.Ordinal))
        {
            target = Navigation.ToAbsoluteUri(value).ToString();
        }
        else
        {
            _syncConnectError = "Use the full Sync DXFER launch link.";
            return Task.CompletedTask;
        }

        Navigation.NavigateTo(target, forceLoad: true);
        return Task.CompletedTask;
    }

    private async Task InvokeMenuCommand(WorkbenchCommandId commandId)
    {
        _isAppMenuOpen = false;
        await MenuCommands.InvokeAsync(commandId);
    }

    private async Task OpenHeaderFileAsync(InputFileChangeEventArgs args)
    {
        _isAppMenuOpen = false;
        try
        {
            if (args.FileCount > 0) await MenuCommands.OpenFileAsync(args.File);
        }
        finally
        {
            _fileInputKey++;
        }
    }
}
