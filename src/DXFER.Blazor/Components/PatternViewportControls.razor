@namespace DXFER.Blazor.Components
@using System.Globalization
@using DXFER.Core.Documents
@using DXFER.Core.Geometry
@using Microsoft.AspNetCore.Components.Web

<section class="pattern-viewport-controls" aria-label="Viewport pattern parameters" data-pattern-id="@Pattern.Id"
         data-source-x="@Number(SourceCenter.X)" data-source-y="@Number(SourceCenter.Y)"
         data-pattern-kind="@Pattern.Kind" data-pitch-x="@Number(Pattern.XPitch)" data-pitch-y="@Number(Pattern.YPitch)"
         data-angle="@Number(Pattern.AngleDegrees)" data-center-x="@Number(Pattern.Center.X)" data-center-y="@Number(Pattern.Center.Y)"
         data-u-x="@Number(DirectionU.X)" data-u-y="@Number(DirectionU.Y)" data-v-x="@Number(DirectionV.X)" data-v-y="@Number(DirectionV.Y)"
         data-pattern-direction-picking="@PickingDirection" data-u-reference="@Pattern.UDirectionReference" data-v-reference="@Pattern.VDirectionReference"
         data-step="@Number(Pattern.FullCircle ? 360d / Pattern.Count : Pattern.StepAngleDegrees)"
         @onkeydown="KeyDown" @onkeydown:stopPropagation="true" @onpointerdown:stopPropagation="true">
    @if (IsRadial)
    {
        <button type="button" class="pattern-center-handle" data-pattern-anchor="center-handle" data-pattern-center-handle
                title="Move pattern center" aria-label="Move pattern center" disabled="@(!CanEdit)" @onclick="BeginCenterEdit">
            <CadIcon Name="CadIconName.Point" />
        </button>
        @if (Draft is { } centerDraft)
        {
            <div class="pattern-center-coordinates" data-pattern-anchor="center">
                <label>Center X (@Units)<input aria-label="Viewport pattern center X" type="number" step="any" @bind="centerDraft.CenterX" @bind:after="NotifyChanged" /></label>
                <label>Center Y (@Units)<input aria-label="Viewport pattern center Y" type="number" step="any" @bind="centerDraft.CenterY" @bind:after="NotifyChanged" /></label>
            </div>
        }
        <div class="pattern-source" data-pattern-anchor="source">
            @if (Draft is { } countDraft)
            {
                <label>Instances<input aria-label="Viewport pattern instances" type="number" min="2" step="1" @bind="countDraft.Count" @bind:after="NotifyChanged" /></label>
            }
            else
            {
                <label>Instances<input aria-label="Viewport pattern instances" value="@Pattern.Count" readonly @ondblclick="Edit" /></label>
            }
        </div>
        <div class="pattern-angle" data-pattern-anchor="angle">
            <div class="pattern-angle-mode" role="group" aria-label="Radial pattern spacing">
                <button type="button" aria-pressed="@(FullCircle ? "true" : "false")" disabled="@(Draft is null)" @onclick="() => SetFullCircle(true)">Full circle</button>
                <button type="button" aria-pressed="@(FullCircle ? "false" : "true")" disabled="@(Draft is null)" @onclick="() => SetFullCircle(false)">Angle between instances</button>
            </div>
            @if (Draft is { } angleDraft)
            {
                <label>Step (deg)<input aria-label="Viewport pattern step angle" type="number" step="any" value="@StepText" readonly="@angleDraft.FullCircle" @onchange="SetStep" /></label>
            }
            else
            {
                <label>Step (deg)<input aria-label="Viewport pattern step angle" value="@Number(Pattern.FullCircle ? 360d / Pattern.Count : Pattern.StepAngleDegrees)" readonly @ondblclick="Edit" /></label>
            }
        </div>
    }
    else
    {
        <div class="pattern-axis" data-pattern-anchor="x">
            @if (Draft is { } xDraft)
            {
                <label>U count<input aria-label="Viewport pattern U count" type="number" min="1" step="1" @bind="xDraft.Columns" @bind:after="NotifyChanged" /></label>
                <label>U pitch (@Units)<input aria-label="Viewport pattern U pitch" type="number" step="any" @bind="xDraft.PitchX" @bind:after="NotifyChanged" /></label>
            }
            else
            {
                <label>U count<input aria-label="Viewport pattern U count" value="@Pattern.Columns" readonly @ondblclick="Edit" /></label>
                <label>U pitch (@Units)<input aria-label="Viewport pattern U pitch" value="@Number(Pattern.XPitch)" readonly @ondblclick="Edit" /></label>
            }
            @AxisTools("U")
        </div>
        <div class="pattern-axis" data-pattern-anchor="y">
            @if (Draft is { } yDraft)
            {
                <label>V count<input aria-label="Viewport pattern V count" type="number" min="1" step="1" @bind="yDraft.Rows" @bind:after="NotifyChanged" /></label>
                <label>V pitch (@Units)<input aria-label="Viewport pattern V pitch" type="number" step="any" @bind="yDraft.PitchY" @bind:after="NotifyChanged" /></label>
            }
            else
            {
                <label>V count<input aria-label="Viewport pattern V count" value="@Pattern.Rows" readonly @ondblclick="Edit" /></label>
                <label>V pitch (@Units)<input aria-label="Viewport pattern V pitch" value="@Number(Pattern.YPitch)" readonly @ondblclick="Edit" /></label>
            }
            @AxisTools("V")
        </div>
    }
    @if (!IsRadial)
    {
        <div class="pattern-stagger-controls" data-pattern-anchor="stagger">
            @if (Draft is { } staggerDraft)
            {
                <label class="pattern-stagger"><input type="checkbox" aria-label="Viewport stagger rows" @bind="staggerDraft.Staggered" @bind:after="NotifyChanged" />Stagger rows</label>
                @if (staggerDraft.Staggered)
                {
                    <label class="pattern-stagger-fraction">Row shift (U fraction)<input type="number" min="0" max="1" step="any" aria-label="Viewport stagger fraction" @bind="staggerDraft.StaggerFraction" @bind:after="NotifyChanged" /></label>
                }
            }
            else
            {
                <label class="pattern-stagger"><input type="checkbox" aria-label="Viewport stagger rows" checked="@(Pattern.Kind == PatternKind.Staggered)" disabled />Stagger rows</label>
                @if (Pattern.Kind == PatternKind.Staggered)
                {
                    <label class="pattern-stagger-fraction">Row shift (U fraction)<input aria-label="Viewport stagger fraction" value="@Number(Pattern.StaggerFraction)" readonly /></label>
                }
            }
        </div>
    }
    <div class="pattern-actions" data-pattern-anchor="actions">
        @if (Error is not null) { <p role="alert">@Error</p> }
        @if (Draft is not null)
        {
            <div class="pattern-action-buttons">
                <button type="button" disabled="@(!CanConfirm)" @onclick="Confirm">Confirm</button>
                <button type="button" title="Cancel pattern changes" aria-label="Cancel pattern changes" @onclick="Cancel"><CadIcon Name="CadIconName.Close" /></button>
            </div>
        }
        else
        {
            <button type="button" disabled="@(!CanEdit)" @onclick="Edit"><CadIcon Name="@(IsRadial ? CadIconName.CircularPattern : CadIconName.LinearPattern)" />Edit pattern</button>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public PatternDefinition Pattern { get; set; } = new();
    [Parameter] public PatternDraft? Draft { get; set; }
    [Parameter] public Point2 SourceCenter { get; set; }
    [Parameter] public Point2 DirectionU { get; set; } = new(1, 0);
    [Parameter] public Point2 DirectionV { get; set; } = new(0, 1);
    [Parameter] public string? PickingDirection { get; set; }
    [Parameter] public string Units { get; set; } = "in";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool CanConfirm { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Confirm { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    [Parameter] public EventCallback Edit { get; set; }
    [Parameter] public EventCallback<string> FlipDirection { get; set; }
    [Parameter] public EventCallback<string> PickDirection { get; set; }
    [Parameter] public EventCallback<string> ClearDirection { get; set; }
    private string? DirectionReference(string axis) => Draft is { } draft
        ? axis == "U" ? draft.UDirectionReference : draft.VDirectionReference
        : axis == "U" ? Pattern.UDirectionReference : Pattern.VDirectionReference;
    private RenderFragment AxisTools(string axis) => @<div class="pattern-axis-tools" role="group" aria-label="@($"{axis} direction")">
        <button type="button" title="@($"Flip {axis} direction")" aria-label="@($"Flip {axis} direction")" disabled="@(Draft is null || !CanEdit)" @onclick="() => FlipDirection.InvokeAsync(axis)"><CadIcon Name="CadIconName.Mirror" /></button>
        <button type="button" class="@(DirectionReference(axis) is null ? null : "is-bound")" title="@(DirectionReference(axis) is null ? $"Pick {axis} direction" : $"{axis} direction linked; pick a replacement edge")" aria-label="@($"Pick {axis} direction")" aria-pressed="@(PickingDirection == axis ? "true" : "false")" disabled="@(Draft is null || !CanEdit)" @onclick="() => PickDirection.InvokeAsync(axis)"><CadIcon Name="CadIconName.Parallel" /></button>
        <button type="button" title="@(axis == "U" ? "Clear U link and use the U angle" : "Clear V link and use perpendicular to U")" aria-label="@($"Clear {axis} direction reference")" disabled="@(Draft is null || !CanEdit || DirectionReference(axis) is null)" @onclick="() => ClearDirection.InvokeAsync(axis)"><CadIcon Name="CadIconName.Close" /></button>
    </div>;
    private bool IsRadial => Draft is { } draft ? draft.Mode == "Radial" : Pattern.Kind == PatternKind.Radial;
    private bool FullCircle => Draft?.FullCircle ?? Pattern.FullCircle;
    private static string Number(double value) => value.ToString("G10", CultureInfo.InvariantCulture);
    private string StepText => Draft is { FullCircle: true } draft
        && int.TryParse(draft.Count, out var count) && count > 0 ? Number(360d / count) : Draft?.StepAngle ?? "";
    private Task NotifyChanged() => Changed.InvokeAsync();
    private Task BeginCenterEdit() => Draft is null && CanEdit ? Edit.InvokeAsync() : Task.CompletedTask;
    private async Task SetFullCircle(bool fullCircle)
    {
        if (Draft is null || Draft.FullCircle == fullCircle) return;
        if (!fullCircle) Draft.StepAngle = StepText;
        Draft.FullCircle = fullCircle;
        await NotifyChanged();
    }
    private async Task SetStep(ChangeEventArgs args)
    {
        if (Draft is null || Draft.FullCircle) return;
        Draft.StepAngle = args.Value?.ToString() ?? "";
        await NotifyChanged();
    }
    private async Task KeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await Cancel.InvokeAsync();
    }
}
