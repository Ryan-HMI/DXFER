@namespace DXFER.Blazor.Components
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject ToolHotkeyService ToolHotkeys

@if (IsOpen)
{
    <div class="dxfer-options-backdrop" @onclick="CloseAsync">
        <section class="dxfer-options-panel"
                 @ref="_panel"
                 aria-label="Tool hotkey settings"
                 @onkeydown="OnPanelKeyDown"
                 @onclick:stopPropagation="true">
            <header class="dxfer-options-header">
                <div>
                    <div class="dxfer-section-title">Tool Hotkeys</div>
                </div>
                <button type="button"
                        class="dxfer-options-icon-button"
                        title="Close"
                        aria-label="Close tool hotkey settings"
                        @onclick="CloseAsync"><CadIcon Name="CadIconName.Close" /></button>
            </header>

            <div class="dxfer-hotkey-search">
                <input type="search" @ref="_searchInput" @bind="_search" @bind:event="oninput"
                       aria-label="Search hotkeys" placeholder="Search commands or shortcuts" autocomplete="off" />
            </div>
            <div class="dxfer-hotkey-grid">
                @foreach (var commandId in FilteredCommands)
                {
                    <label class="dxfer-hotkey-row" @key="commandId">
                        <span>@ToolHotkeyResolver.FormatCommandName(commandId)</span>
                        <input value="@GetKey(commandId)"
                               maxlength="32"
                               readonly
                               autocomplete="off"
                               spellcheck="false"
                               data-dxfer-hotkey-input="true"
                               data-dxfer-accepted-hotkey="@GetKey(commandId)"
                               aria-label="@($"{ToolHotkeyResolver.FormatCommandName(commandId)} hotkey")"
                               @onchange="args => ChangeHotkeyAsync(commandId, args.Value?.ToString() ?? string.Empty)" />
                    </label>
                }
                @if (!FilteredCommands.Any())
                {
                    <div class="dxfer-hotkey-empty" role="status">No matching commands</div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="dxfer-options-error" role="alert">@_error</div>
            }

            <footer class="dxfer-options-footer">
                <button type="button" class="dxfer-options-command" @onclick="ResetAsync">Reset all</button>
                <button type="button" class="dxfer-options-command" @onclick="CloseAsync">Close</button>
            </footer>
        </section>
    </div>
}

@code {
    private const string ModulePath = "./_content/DXFER.Blazor/workbenchHotkeys.js?v=20261016-search-hotkeys";
    private const string StorageKey = "dxfer.toolHotkeys.v2";
    private IJSObjectReference? _module;
    private ElementReference _panel;
    private ElementReference _searchInput;
    private string _search = string.Empty;
    private bool _wasOpen;
    private bool _focusSearch;
    private bool _loaded;
    private string? _error;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IEnumerable<WorkbenchCommandId> FilteredCommands => ToolHotkeyResolver.ToolCommandIds
        .Where(id => string.IsNullOrWhiteSpace(_search)
            || ToolHotkeyResolver.FormatCommandName(id).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || GetKey(id).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _search = string.Empty;
            _error = null;
            _focusSearch = true;
        }
        _wasOpen = IsOpen;
    }

    private async Task OnPanelKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
        }

        if (!_loaded)
        {
            var json = await _module.InvokeAsync<string?>("getStoredToolHotkeys", StorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var bindings = JsonSerializer.Deserialize<IReadOnlyList<ToolHotkeyBinding>>(json);
                ToolHotkeys.Load(bindings);
            }

            _loaded = true;
            StateHasChanged();
        }

        if (IsOpen)
        {
            await _module.InvokeVoidAsync("enableToolHotkeyRecorders", _panel);
            if (_focusSearch)
            {
                _focusSearch = false;
                await _searchInput.FocusAsync();
            }
        }
    }

    private string GetKey(WorkbenchCommandId commandId) => ToolHotkeys.GetKey(commandId) ?? string.Empty;

    private async Task ChangeHotkeyAsync(WorkbenchCommandId commandId, string key)
    {
        _error = null;

        try
        {
            ToolHotkeys.SetBinding(commandId, key);
            await PersistAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
    }

    private async Task ResetAsync()
    {
        _error = null;
        ToolHotkeys.ResetToDefaults();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("clearStoredToolHotkeys", StorageKey);
        }
    }

    private async Task PersistAsync()
    {
        if (_module is null)
        {
            return;
        }

        var json = JsonSerializer.Serialize(ToolHotkeys.Bindings);
        await _module.InvokeVoidAsync("setStoredToolHotkeys", StorageKey, json);
    }

    private async Task CloseAsync() => await OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
