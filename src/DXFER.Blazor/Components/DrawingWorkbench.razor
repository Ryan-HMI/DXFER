@namespace DXFER.Blazor.Components
@using Microsoft.AspNetCore.Components.Routing
@using DXFER.Core.Operations
@using DXFER.Core.Sketching

<NavigationLock ConfirmExternalNavigation="HasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<div class="@WorkbenchCssClass" style="@WorkbenchGridStyle">
    <div class="dxfer-tool-palette-host" aria-label="Dockable tool groups">
        <WorkbenchToolPalette Groups="@ToolGroups"
                              OnCommandInvoked="InvokeWorkbenchCommand" />
    </div>

    <main class="dxfer-canvas-panel">
        <DrawingCanvas @ref="_canvas"
                       Document="_document"
                       FullDocument="_document"
                       CornerPreview="CornerPreview"
                       PatternPreview="PatternPreview"
                       PatternEditing="PatternEditing"
                       PatternControls="ViewportPatternControls"
                       PatternCenterChanged="MovePatternCenter"
                       PatternCenterPicked="SelectPatternCenter"
                       PatternDirectionPicked="PickPatternDirection"
                       CornerHandle="@(CornerPreview is not null && _cornerPreviewHandle is not null ? new CanvasPointDto(_cornerPreviewHandle.Value.X, _cornerPreviewHandle.Value.Y) : null)"
                       CornerSize="GetCornerModifyDistance()"
                       CornerSizeChanged="OnCornerSizeDragged"
                       CornerApplyRequested="CommitStagedPreview"
                       ShowToolbar="false"
                       DocumentFitToken="_documentFitToken"
                       ActiveTool="_activeTool"
                       Measurement="ViewportMeasurement"
                       MeasurementUnits="@DocumentUnitsText"
                       ShowOriginAxes="_showOriginAxes"
                       ShowAllConstraints="_showAllConstraints"
                       GrainDirection="_grainDirection"
                       GrainAngleDegrees="_grainAngleDegrees"
                       ConstructionMode="_constructionMode"
                       AutomaticSnapConstraints="MenuCommandService.AutomaticSnapConstraints"
                       InvertWheelZoom="MenuCommandService.InvertWheelZoom"
                       SelectionResetToken="_selectionResetToken"
                       HoveredEntityChanged="OnHoveredEntityChanged"
                       SelectionChanged="OnSelectionChanged"
                       ActiveSelectionChanged="OnActiveSelectionChanged"
                       ContextMenuRequested="OpenContextMenu"
                       ToolCommitRequested="OnToolCommitRequested"
                       SlotCommitRequested="OnLineSlotCommitRequested"
                       ToolFeedbackRequested="OnToolFeedbackRequested"
                       ToolModeChanged="OnCanvasToolModeChanged"
                       SplitAtPointRequested="OnSplitAtPointRequested"
                       ConstructionToggleRequested="OnConstructionToggleRequested"
                       ModifyToolCommitRequested="OnModifyToolCommitRequested"
                       AddSplinePointRequested="OnAddSplinePointRequested"
                       PowerTrimRequested="OnPowerTrimRequested"
                       PowerTrimCrossingRequested="OnPowerTrimCrossingRequested"
                       ToolCancelRequested="OnToolCanceled"
                       SketchDimensionValueChanged="OnSketchDimensionValueChanged"
                       SketchDimensionAnchorChanged="OnSketchDimensionAnchorChanged"
                       SketchDimensionPlacementRequested="OnSketchDimensionPlacementRequested"
                       GeometryDragRequested="OnGeometryDragRequested"
                       DeleteSelectionRequested="DeleteSelectedGeometry" />
    </main>

    @if (_contextOpen)
    {
        <div class="dxfer-context-dismiss" @onpointerdown="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
        <section class="dxfer-context-menu" style="@ContextStyle" role="dialog" aria-label="Drawing context commands"
                 tabindex="-1" @ref="_contextMenu" @onkeydown="ContextKeyDown" @onkeydown:stopPropagation="true"
                 @oncontextmenu:preventDefault="true">
            @if (PatternEditing && _editingPattern is { } activePattern)
            {
                <button type="button" disabled="@(!CanTogglePatternControls(activePattern))"
                        @onclick="() => TogglePatternControls(activePattern)">
                    <CadIcon Name="@(ViewportPattern?.Id == activePattern.Id ? CadIconName.EyeOff : CadIconName.Eye)" />
                    @(ViewportPattern?.Id == activePattern.Id ? "Hide pattern controls" : "Show pattern controls")
                </button>
            }
            else if (ContextDimension is { } dimension)
            {
                <fieldset disabled="@(!ContextEditable)">
                    <legend>Dimension</legend>
                    <label><input type="radio" name="dimension-mode" checked="@dimension.IsDriving" @onchange="() => ContextDimensionMode(true)" />Driving</label>
                    <label><input type="radio" name="dimension-mode" checked="@(!dimension.IsDriving)" @onchange="() => ContextDimensionMode(false)" />Driven</label>
                </fieldset>
                @if (dimension.Kind is SketchDimensionKind.Radius or SketchDimensionKind.Diameter)
                {
                    <fieldset disabled="@(!ContextEditable)">
                        <legend>Display</legend>
                        <label><input type="radio" name="dimension-radial-kind" checked="@(dimension.Kind == SketchDimensionKind.Radius)" @onchange="() => ContextDimensionRadialKind(SketchDimensionKind.Radius)" />Radius (R)</label>
                        <label><input type="radio" name="dimension-radial-kind" checked="@(dimension.Kind == SketchDimensionKind.Diameter)" @onchange="() => ContextDimensionRadialKind(SketchDimensionKind.Diameter)" />Diameter (&#8960;)</label>
                    </fieldset>
                }
            }
            else if (_contextEntities.Length > 0)
            {
                @foreach (var pattern in ContextPatterns)
                {
                    <button type="button" disabled="@(!CanTogglePatternControls(pattern))"
                            title="@(CanTogglePatternControls(pattern) ? PatternLabel(pattern) : "Finish the active pattern edit first")"
                            @onclick="() => TogglePatternControls(pattern)">
                        <CadIcon Name="@(PatternControlsVisible(pattern) ? CadIconName.EyeOff : CadIconName.Eye)" />
                        @(PatternControlsVisible(pattern) ? "Hide pattern controls" : "Show pattern controls")
                    </button>
                }
                <button type="button" disabled="@(!ContextEditable)" @onclick="() => ContextCommand(WorkbenchCommandId.LinearPattern)"><CadIcon Name="CadIconName.LinearPattern" />Pattern</button>
                @if (ContextCorner)
                {
                    <button type="button" disabled="@(!ContextEditable)" @onclick="() => ContextCommand(WorkbenchCommandId.Fillet, true)"><CadIcon Name="CadIconName.Fillet" />Fillet</button>
                    <button type="button" disabled="@(!ContextEditable)" @onclick="() => ContextCommand(WorkbenchCommandId.Chamfer, true)"><CadIcon Name="CadIconName.Chamfer" />Chamfer</button>
                }
                <button type="button" disabled="@(!ContextEditable)" @onclick="() => ContextCommand(WorkbenchCommandId.Offset)"><CadIcon Name="CadIconName.Offset" />Offset</button>
                <button type="button" disabled="@(!ContextEditable)" @onclick="() => ContextCommand(WorkbenchCommandId.Translate)"><CadIcon Name="CadIconName.Move" />Move</button>
                <button type="button" disabled="@(!ContextEditable)" @onclick="() => ContextCommand(WorkbenchCommandId.Dimension)"><CadIcon Name="CadIconName.Dimension" />Dimension</button>
                <button type="button" disabled="@(!ContextEditable)" @onclick="() => ContextCommand(WorkbenchCommandId.Construction)"><CadIcon Name="CadIconName.Construction" />Toggle construction</button>
                <label class="dxfer-context-layer">Move to layer
                    <select aria-label="Move to layer" value="@_contextLayer" disabled="@(!ContextEditable)" @onchange="ContextMoveLayer">
                        <option value="" disabled>Select layer</option>
                        @foreach (var layer in Layers)
                        {
                            <option value="@layer.Key" disabled="@(layer.Value.IsHidden || layer.Value.IsLocked)">@layer.Key</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <span class="dxfer-context-empty">No editable geometry</span>
            }
            <button type="button" @onclick="CloseContextMenu"><CadIcon Name="CadIconName.Close" />Close</button>
        </section>
    }

    @if (EnableFullEditing)
    {
    <aside class="dxfer-information-panel" aria-label="Drawing controls">
    @if (IsOperationInspectorVisible)
    {
        <aside class="dxfer-operation-inspector @(PatternEditing ? "dxfer-pattern-active" : "")" aria-label="Active operation" @onkeydown="HandleInspectorEscape">
            <header class="dxfer-operation-heading">
                <h2>@ActiveToolLabel</h2>
            </header>
            <div class="dxfer-operation-feedback">
                @if (IsCornerModifyToolActive)
                {
                    @CornerSizeControl
                }
                @if (_patternDraft is not null)
                {
                    <PatternEditor Draft="_patternDraft" Units="@DocumentUnitsText" CanConfirm="CanConfirmPatternPreview"
                                   PickingDirection="@_patternDirectionPicking" FlipDirection="FlipPatternAxis" PickDirection="BeginPatternDirectionPick" ClearDirection="ClearPatternDirection"
                                   Error="@_patternError" Changed="RefreshPatternPreview" Confirm="CommitPatternPreview" Cancel="ExitInspectorTool" Fit="FitAsync" />
                    @if (_document.Metadata.Patterns.Any(p => p.Id == _editingPattern?.Id))
                    {
                        @if (_confirmDissolvePattern)
                        {
                            <div class="dxfer-pattern-unlink" role="group" aria-label="Unlink pattern confirmation">
                                <span>Unlink copies from source?</span>
                                <button type="button" class="dxfer-exit-tool" @onclick="DissolvePattern">Unlink</button>
                                <button type="button" class="dxfer-exit-tool" @onclick="() => _confirmDissolvePattern = false">Keep linked</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="dxfer-exit-tool" @onclick="() => _confirmDissolvePattern = true">Unlink pattern</button>
                        }
                    }
                }
            </div>
            @if (!PatternEditing)
            {
            <footer class="dxfer-operation-actions">
                @if (IsCornerModifyToolActive)
                {
                    @CornerActions
                }
                else if (_activeTool.HasValue && !PatternEditing)
                {
                <button type="button" class="dxfer-exit-tool" title="Exit current tool" @onclick="ExitInspectorTool">
                    <CadIcon Name="CadIconName.Close" />
                    <span>Exit tool</span>
                </button>
                }
            </footer>
            }
        </aside>
    }
        @if (_document.Metadata.Patterns.Count > 0 && !PatternEditing)
        {
            <section class="dxfer-pattern-list" aria-label="Patterns">
                <header class="dxfer-operation-heading"><h2>Patterns</h2></header>
                @foreach (var pattern in _document.Metadata.Patterns)
                {
                    <button type="button" class="dxfer-exit-tool" disabled="@LayersReadOnly" @onclick="() => OpenPatternEditor(pattern)">
                        <CadIcon Name="@(pattern.Kind == DXFER.Core.Documents.PatternKind.Radial ? CadIconName.CircularPattern : CadIconName.LinearPattern)" />@PatternLabel(pattern)
                    </button>
                }
            </section>
        }
        <section class="dxfer-layers" aria-label="Layers">
            <header class="dxfer-operation-heading">
                <h2>Layers</h2>
                <div class="dxfer-layer-tools">
                    <button type="button" title="Add layer" aria-label="Add layer" disabled="@LayersReadOnly" @onclick="AddLayer"><CadIcon Name="CadIconName.Plus" /></button>
                    <button type="button" title="@(_layersCollapsed ? "Expand layers" : "Collapse layers")" aria-label="@(_layersCollapsed ? "Expand layers" : "Collapse layers")" aria-expanded="@(_layersCollapsed ? "false" : "true")" @onclick="() => _layersCollapsed = !_layersCollapsed"><CadIcon Name="@(_layersCollapsed ? CadIconName.ChevronDown : CadIconName.ChevronUp)" /></button>
                </div>
            </header>
            @if (!_layersCollapsed)
            {
                <div class="dxfer-layer-list">
                @foreach (var pair in Layers)
                {
                    var name = pair.Key;
                    var layer = pair.Value;
                    <div class="dxfer-layer-row @(SelectedLayerName == name ? "selected" : "")" @key="name" data-layer="@name">
                        <button type="button" title="@(layer.IsHidden ? "Show layer" : "Hide layer")" aria-label="@($"{(layer.IsHidden ? "Show" : "Hide")} layer {name}")" disabled="@LayersReadOnly" @onclick="() => ToggleLayerVisible(name)"><CadIcon Name="@(layer.IsHidden ? CadIconName.EyeOff : CadIconName.Eye)" /></button>
                        <button type="button" title="@(layer.IsLocked ? "Unlock layer" : "Lock layer")" aria-label="@($"{(layer.IsLocked ? "Unlock" : "Lock")} layer {name}")" disabled="@LayersReadOnly" @onclick="() => ToggleLayerLock(name)"><CadIcon Name="@(layer.IsLocked ? CadIconName.Lock : CadIconName.Unlock)" /></button>
                        <input type="color" value="@DrawingLayerService.Color(layer)" title="@($"Layer color: {name}")" aria-label="@($"Layer color {name}")" disabled="@LayersReadOnly" @onchange="e => ChangeLayerColor(name, e)" />
                        <button type="button" class="dxfer-layer-name" title="@name" aria-label="@($"Layer {name}")" aria-pressed="@(SelectedLayerName == name ? "true" : "false")" @onclick="() => PickLayer(name)">@name</button>
                        <span class="dxfer-layer-count" title="Entity count">@LayerCount(name)</span>
                    </div>
                }
                </div>
                <div class="dxfer-layer-details" @onkeydown:stopPropagation="true">
                    <label>Layer name<input aria-label="Layer name" @bind="LayerNameDraft" @bind:event="oninput" disabled="@(LayersReadOnly || SelectedLayerName == "0")" /></label>
                    <button type="button" class="dxfer-exit-tool" disabled="@(LayersReadOnly || SelectedLayerName == "0")" @onclick="RenameLayer">Rename</button>
                    <div class="dxfer-layer-tools">
                        <button type="button" title="Select all on layer" aria-label="Select all on layer" disabled="@(SelectedLayer.IsHidden || SelectedLayer.IsLocked || LayerCount(SelectedLayerName) == 0)" @onclick="SelectLayerEntities"><CadIcon Name="CadIconName.SelectLayer" /></button>
                        <button type="button" title="Move selection to layer" aria-label="Move selection to layer" disabled="@(LayersReadOnly || _selectedEntityIds.Count == 0 || SelectedLayer.IsHidden || SelectedLayer.IsLocked)" @onclick="MoveToLayer"><CadIcon Name="CadIconName.Move" /></button>
                        <button type="button" title="Delete empty layer" aria-label="Delete empty layer" disabled="@(LayersReadOnly || SelectedLayerName == "0" || SelectedLayerName == _document.Metadata.ActiveLayerName || LayerCount(SelectedLayerName) != 0)" @onclick="DeleteLayer"><CadIcon Name="CadIconName.Delete" /></button>
                    </div>
                    <label class="dxfer-layer-current"><input type="radio" name="current-layer" aria-label="Use as current drawing layer" checked="@(SelectedLayerName == _document.Metadata.ActiveLayerName)" disabled="@(LayersReadOnly || SelectedLayer.IsHidden || SelectedLayer.IsLocked)" @onchange="SetCurrentLayer" />Current drawing layer</label>
                    @if (_layerError is not null) { <p role="alert">@_layerError</p> }
                </div>
            }
        </section>
    </aside>
    }

    @if (IsSyncLaunch)
    {
        <section class="dxfer-sync-control-bar" aria-label="Sync connection status">
            <span class="@SyncCallbackStateClass">@SyncCallbackStateText</span>
            <button type="button"
                    class="dxfer-sync-send-button"
                    title="@SyncSaveButtonTitle"
                    disabled="@(!CanSaveBackToSync)"
                    @onclick="() => InvokeWorkbenchCommand(WorkbenchCommandId.SendToSync)">
                @SyncSaveButtonText
            </button>
        </section>
    }

    <footer class="dxfer-command-bar" aria-label="Command and measurement readout">
        <div class="dxfer-command-prompt" role="status">@CommandPromptText</div>
        @if (!IsOperationInspectorVisible && IsCornerModifyToolActive)
        {
            <div class="dxfer-corner-toolbar">
            @if (IsCornerModifyToolActive)
            {
                @CornerSizeControl
                @CornerActions
            }
            </div>
        }
        <div class="dxfer-command-chips" aria-label="Live measurement readout">
            @if (HasDocument)
            {
                <div class="dxfer-live-readout-item" title="@CurrentCutLength.CutLengthReviewReason"
                     aria-label="@($"Cut total: {CutLengthText}. {CurrentCutLength.CutLengthReviewReason}")">
                    <span class="dxfer-live-readout-label">Cut total</span>
                    <span class="dxfer-live-readout-value">@CutLengthText</span>
                </div>
                <div class="dxfer-live-readout-item" title="@CurrentContours.ContourReviewReason"
                     aria-label="@($"Contours: {ContourCountText}. {CurrentContours.ContourReviewReason}")">
                    <span class="dxfer-live-readout-label">Contours</span>
                    <span class="dxfer-live-readout-value">@ContourCountText</span>
                </div>
            }
            @foreach (var item in FooterMeasurementReadouts)
            {
                <div class="dxfer-live-readout-item">
                    <span class="dxfer-live-readout-label">@item.Label</span>
                    <span class="dxfer-live-readout-value" title="@item.Value">@item.Value</span>
                </div>
            }
        </div>
    </footer>

</div>

@code {
    private RenderFragment ViewportPatternControls => @<text>
        @if (ViewportPattern is { } pattern)
        {
            <PatternViewportControls @key="pattern.Id" Pattern="pattern" Draft="_patternDraft"
                                     SourceCenter="PatternSourceCenter(pattern)" SourceBounds="PatternSourceBounds(pattern)" Units="@DocumentUnitsText"
                                     DirectionU="PatternDirection(pattern, true)" DirectionV="PatternDirection(pattern, false)"
                                     PickingDirection="@_patternDirectionPicking" FlipDirection="FlipPatternAxis" PickDirection="BeginPatternDirectionPick" ClearDirection="ClearPatternDirection"
                                     CanConfirm="CanConfirmPatternPreview" CanEdit="CanEditViewportPattern(pattern)"
                                     Error="@_patternError" Changed="RefreshPatternPreview" Confirm="CommitPatternPreview"
                                     Cancel="ExitInspectorTool" />
        }
    </text>;

    private RenderFragment CornerActions => @<text>
        <button type="button" class="dxfer-exit-tool dxfer-confirm-corner" disabled="@(CornerPreview is null)" @onclick="CommitCornerPreview">
            <CadIcon Name="@(_activeTool == WorkbenchTool.Fillet ? CadIconName.Fillet : CadIconName.Chamfer)" />
            <span>Confirm</span>
        </button>
        <button type="button" class="dxfer-exit-tool" @onclick="ExitInspectorTool">
            <CadIcon Name="CadIconName.Close" />
            <span>Cancel</span>
        </button>
    </text>;

    private RenderFragment CornerSizeControl => @<label class="dxfer-corner-size-control" @onkeydown="HandleInspectorKeyDown" @onkeydown:stopPropagation="true">
        <span>@(_activeTool == WorkbenchTool.Fillet ? "Radius" : "Distance") <span class="dxfer-input-units">(@DocumentUnitsText)</span></span>
        <input type="number" min="0" step="0.1" @bind="CornerSizeDraft" @bind:event="oninput"
               aria-label="@($"{ActiveToolLabel} size ({DocumentUnitsText})")"
               aria-invalid="@(_cornerModifyDistanceInvalid ? "true" : "false")" />
    </label>;
}
