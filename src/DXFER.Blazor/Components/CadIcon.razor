@namespace DXFER.Blazor.Components

<svg class="@CssClass"
     width="20"
     height="20"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.6"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @if (ConstraintIconGeometry.All.TryGetValue(Name.ToString().ToLowerInvariant(), out var constraintIcon))
    {
        <path d="@constraintIcon.Outline" />
        @if (constraintIcon.Fill is not null)
        {
            <path d="@constraintIcon.Fill" fill="currentColor" stroke="none" />
        }
    }
    else
    {
    @switch (Name)
    {
        case CadIconName.NewFile:
            <path d="M5 3h9l5 5v13H5ZM14 3v5h5M8 14h8m-4-4v8"/>
            break;
        case CadIconName.FolderOpen:
            <path d="M3 19V5h6l2 3h10v3M3 19l3-8h16l-3 8Z"/>
            break;
        case CadIconName.Sample:
            <path d="M5 4.5h8l4 4V19a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 4 19V6a1.5 1.5 0 0 1 1.5-1.5Z" />
            <path d="M13 4.5V9h4" />
            <path d="M7.5 16.5 10.5 11l2.5 3 1.5-2 2.5 4.5Z" />
            <circle cx="8" cy="9" r="1" fill="currentColor" />
            break;
        case CadIconName.Export:
            <path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/>
            break;
        case CadIconName.Hotkeys:
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <path d="M6 9h1m4 0h1m4 0h1M6 13h1m4 0h1m4 0h1M7 16h10"/>
            break;
        case CadIconName.CollapseLeft:
            <path d="M4 5h16" />
            <path d="M4 19h16" />
            <path d="M8 5v14" />
            <path d="m15 9-3 3 3 3" />
            break;
        case CadIconName.CollapseRight:
            <path d="M4 5h16" />
            <path d="M4 19h16" />
            <path d="M16 5v14" />
            <path d="m9 9 3 3-3 3" />
            break;
        case CadIconName.ChevronUp:
            <path d="m7 14 5-5 5 5" />
            break;
        case CadIconName.ChevronDown:
            <path d="m6 9 6 6 6-6"/>
            break;
        case CadIconName.Measure:
            <path d="m3 16 13-13 5 5-13 13Zm5-5 3 3m0-6 2 2m1-5 3 3"/>
            break;
        case CadIconName.Undo:
            <path d="m8 5-5 5 5 5M4 10h10a6 6 0 0 1 0 12"/>
            break;
        case CadIconName.Redo:
            <path d="m16 5 5 5-5 5M20 10H10a6 6 0 0 0 0 12"/>
            break;
        case CadIconName.Line:
            <path d="M5 19 19 5"/>
            <circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="19" cy="5" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.MidpointLine:
            <path d="M4 18 20 6"/>
            <circle cx="4" cy="18" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="20" cy="6" r="1.4" fill="currentColor" stroke="none"/>
            <rect x="10.4" y="10.4" width="3.2" height="3.2" rx="0"/>
            break;
        case CadIconName.Rectangle:
            <rect x="4" y="6" width="16" height="12" rx="0"/>
            <circle cx="4" cy="6" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="20" cy="18" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.CenterRectangle:
            <rect x="4" y="6" width="16" height="12" rx="0"/>
            <path d="M9 12h6m-3-3v6"/>
            break;
        case CadIconName.AlignedRectangle:
            <path d="m3 12 12-8 6 8-12 8Z"/>
            <circle cx="3" cy="12" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="15" cy="4" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.Circle:
            <circle cx="12" cy="12" r="8"/>
            <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>
            <path d="m13.5 10.5 4-4"/>
            break;
        case CadIconName.ThreePointCircle:
            <circle cx="12" cy="12" r="8"/>
            <circle cx="12" cy="4" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="5.1" cy="16" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="18.9" cy="16" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.Ellipse:
            <ellipse cx="12" cy="12" rx="9" ry="6"/>
            <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.Arc:
            <path d="M4 18a8 8 0 0 1 16 0"/>
            <circle cx="4" cy="18" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="12" cy="10" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="20" cy="18" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.TangentArc:
            <path d="M4 17h7" opacity="0.6" />
            <path d="M11 17c3.2 0 6.5-2.6 8-7" />
            <path d="M11 17h4" opacity="0.45" stroke-dasharray="2 2" />
            <circle cx="11" cy="17" r="1.15" fill="currentColor" />
            <circle cx="19" cy="10" r="0.95" fill="currentColor" />
            break;
        case CadIconName.CenterPointArc:
            <path d="M4 18a12 12 0 0 1 12-12M4 18h12V6"/>
            <circle cx="16" cy="18" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.EllipticalArc:
            <path d="M3 15a9 6 0 0 1 18 0"/>
            <circle cx="3" cy="15" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="21" cy="15" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.Conic:
            <path d="M4 19Q12-9 20 19"/>
            <circle cx="4" cy="19" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="12" cy="5" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="20" cy="19" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.InscribedPolygon:
            <circle cx="12" cy="12" r="9"/>
            <path d="m12 3 8.6 6.2-3.3 10.1H6.7L3.4 9.2Z"/>
            break;
        case CadIconName.CircumscribedPolygon:
            <path d="M12 3.348 20.23 9.327 17.087 18.999 6.913 18.999 3.77 9.327Z" opacity="0.35" />
            <circle cx="12" cy="12" r="7" />
            break;
        case CadIconName.Spline:
            <path d="M3 18C9 18 5 5 12 6S15 18 21 5"/>
            <circle cx="3" cy="18" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="12" cy="6" r="1.4" fill="currentColor" stroke="none"/>
            <circle cx="21" cy="5" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.Bezier:
            <path d="M5 17c5-12 9 4 14-8" />
            <path d="M5 17 8 7" opacity="0.45" />
            <path d="M19 9 16 18" opacity="0.45" />
            <circle cx="8" cy="7" r="1" />
            <circle cx="16" cy="18" r="1" />
            break;
        case CadIconName.SplineControlPoint:
            <path d="M3 18C9 18 5 5 12 6S15 18 21 5M17 17h6m-3-3v6"/>
            <circle cx="12" cy="6" r="1.4" fill="currentColor" stroke="none"/>
            break;
        case CadIconName.Point:
            <path d="M12 3v5m0 8v5M3 12h5m8 0h5"/>
            <circle cx="12" cy="12" r="2"/>
            break;
        case CadIconName.Text:
            <path class="dxfer-text-a-icon" d="M6 20 12 4l6 16" />
            <path d="M8.6 14h6.8" />
            break;
        case CadIconName.Construction:
            <path d="M5 19 19 5" stroke-dasharray="2 3" />
            break;
        case CadIconName.Delete:
            <path d="M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7m4-7v7"/>
            break;
        case CadIconName.Slot:
            <rect x="3" y="7" width="18" height="10" rx="5"/>
            <path d="M7 12h10"/>
            break;
        case CadIconName.PowerTrim:
            <line x1="7" y1="4" x2="7" y2="20"/>
            <line x1="17" y1="4" x2="17" y2="20"/>
            <line x1="2" y1="12" x2="7" y2="12"/>
            <line x1="17" y1="12" x2="22" y2="12"/>
            <line x1="10" y1="9" x2="14" y2="15"/>
            <line x1="14" y1="9" x2="10" y2="15"/>
            break;
        case CadIconName.Split:
            <g class="dxfer-split-point-icon">
                <path d="M3 12h5m8 0h5M8 9v6m8-6v6M10 4l2 3 2-3" />
                <circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none" />
            </g>
            break;
        case CadIconName.Offset:
            <path d="M3 18V6h14M7 22V10h14M12 14v5m-2-2 2 2 2-2"/>
            break;
        case CadIconName.Fillet:
            <path d="M4 20V12a8 8 0 0 1 8-8h8"/>
            <path d="M4 7V4h3"/>
            break;
        case CadIconName.Chamfer:
            <path d="M4 20V12l8-8h8"/>
            <path d="M4 7V4h3"/>
            break;
        case CadIconName.Dimension:
            <path d="M5 3v18m14-18v18M5 12h14m-11-3-3 3 3 3m8-6 3 3-3 3"/>
            break;
        case CadIconName.Move:
            <path d="M12 3v18M3 12h18M9 6l3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3m12-6 3 3-3 3"/>
            break;
        case CadIconName.Rotate:
            <g class="dxfer-rotate-free-icon">
                <path d="M18.92820323 8A8 8 0 1 1 12 4" stroke-width="2" />
                <path fill="currentColor" stroke="none" d="M16.5 4 11 1 11 7Z" />
            </g>
            break;
        case CadIconName.Rotate90Clockwise:
            <g class="dxfer-rotate-90-cw-icon">
                <path fill="currentColor" stroke="none" d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-8 3.58-8 8s3.58 8 8 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
            </g>
            break;
        case CadIconName.Rotate90CounterClockwise:
            <g class="dxfer-rotate-90-ccw-icon">
                <path fill="currentColor" stroke="none" d="M6.35 6.35C7.8 4.9 9.79 4 12 4c4.42 0 8 3.58 8 8s-3.58 8-8 8c-3.73 0-6.84-2.55-7.73-6h2.08c.82 2.33 3.04 4 5.65 4 3.31 0 6-2.69 6-6s-2.69-6-6-6c-1.66 0-3.14.69-4.22 1.78L11 11H4V4l2.35 2.35z" />
            </g>
            break;
        case CadIconName.Scale:
            <rect x="4" y="14" width="6" height="6" fill="currentColor" />
            <rect x="4" y="4" width="16" height="16" />
            break;
        case CadIconName.Mirror:
            <path d="M12 3v3m0 3v6m0 3v3M8 6 3 18h5ZM16 6l5 12h-5Z"/>
            break;
        case CadIconName.LinearPattern:
            <rect x="5" y="5" width="5" height="5" fill="currentColor" />
            <rect x="14" y="5" width="5" height="5" />
            <rect x="5" y="14" width="5" height="5" />
            <rect x="14" y="14" width="5" height="5" />
            break;
        case CadIconName.CircularPattern:
            <g class="dxfer-circular-pattern-icon">
                <circle cx="12" cy="5" r="1.35" fill="currentColor" />
                <circle cx="18.1" cy="8.5" r="1.35" />
                <circle cx="18.1" cy="15.5" r="1.35" />
                <circle cx="12" cy="19" r="1.35" />
                <circle cx="5.9" cy="15.5" r="1.35" />
                <circle cx="5.9" cy="8.5" r="1.35" />
            </g>
            break;
        case CadIconName.Normal:
            <path d="M3 19Q12 8 21 19M12 14V3m-3 3 3-3 3 3M12 14h4v3"/>
            break;
        case CadIconName.Pierce:
            <path d="M5 19 19 5" />
            <circle cx="12" cy="12" r="3" />
            <circle cx="12" cy="12" r="1" fill="currentColor" />
            break;
        case CadIconName.Symmetric:
            <path d="M12 3v3m0 3v6m0 3v3M3 6l5 6-5 6m18-12-5 6 5 6"/>
            break;
        case CadIconName.Curvature:
            <path d="M5 18c3-10 10-13 14-8" />
            <path d="M5 18a8 8 0 0 1 8-8" stroke-dasharray="2 2" />
            break;
        case CadIconName.Fit:
            <path d="M3 9V3h6m6 0h6v6M3 15v6h6m6 0h6v-6"/>
            <rect x="8" y="8" width="8" height="8" rx="1"/>
            break;
        case CadIconName.AutoCleanup:
            <g class="dxfer-auto-cleanup-icon">
                <path d="M4 17 9 6l5 11" />
                <path d="M6.1 12.5h5.8" />
                <path d="M15 7h4v4" />
                <path d="M19 7l-5 5" />
            </g>
            break;
        case CadIconName.BoundsToOrigin:
            <path d="M4 20V5" />
            <path d="M4 20h15" />
            <path d="M8 16h8V8H8z" />
            <path d="m8 16-4 4" />
            break;
        case CadIconName.PointToOrigin:
            <path d="M4 20V5" />
            <path d="M4 20h15" />
            <circle cx="14" cy="10" r="3" />
            <path d="m12 12-8 8" />
            break;
        case CadIconName.OriginAxes:
            <path d="M5 3v16h16m-19-13 3-3 3 3m10 10 3 3-3 3"/>
            break;
        case CadIconName.Menu:
            <path d="M4 6h16M4 12h16M4 18h16"/>
            break;
        case CadIconName.Close:
            <path d="m6 6 12 12M6 18 18 6"/>
            break;
        case CadIconName.ShowConstraints:
            <path d="M4 12s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" />
            <circle cx="12" cy="12" r="2.2" />
            <rect x="4.5" y="4.5" width="4.5" height="4.5" rx="0.5" />
            <path d="M5.7 6.8h2" />
            <rect x="15" y="15" width="4.5" height="4.5" rx="0.5" />
            <path d="M16.1 17.3h2.3" />
            break;
        case CadIconName.VectorToX:
            <path d="M3 19h18m-3-3 3 3-3 3M5 13l12-8M8 8l-3 5 6-1"/>
            break;
        case CadIconName.VectorToY:
            <path d="M5 3v18M2 6l3-3 3 3M11 17l7-12m-5 3 5-3-1 6"/>
            break;
        case CadIconName.GrainNone:
            <g class="dxfer-grain-none-icon">
                <circle cx="12" cy="12" r="7" />
                <path d="M6 6l12 12" />
            </g>
            break;
        case CadIconName.GrainX:
            <g class="dxfer-grain-icon dxfer-grain-x-icon">
                <text x="6.3" y="14.8" fill="currentColor" stroke="none" font-family="Segoe UI, Arial, sans-serif" font-size="13" font-weight="700">G</text>
                <text x="14.2" y="18" fill="currentColor" stroke="none" font-family="Segoe UI, Arial, sans-serif" font-size="7" font-weight="700">X</text>
            </g>
            break;
        case CadIconName.GrainY:
            <g class="dxfer-grain-icon dxfer-grain-y-icon">
                <text x="6.3" y="14.8" fill="currentColor" stroke="none" font-family="Segoe UI, Arial, sans-serif" font-size="13" font-weight="700">G</text>
                <text x="14.2" y="18" fill="currentColor" stroke="none" font-family="Segoe UI, Arial, sans-serif" font-size="7" font-weight="700">Y</text>
            </g>
            break;
        case CadIconName.GrainVector:
            <g class="dxfer-grain-icon dxfer-grain-v-icon">
                <text x="6.3" y="14.8" fill="currentColor" stroke="none" font-family="Segoe UI, Arial, sans-serif" font-size="13" font-weight="700">G</text>
                <text x="14.2" y="18" fill="currentColor" stroke="none" font-family="Segoe UI, Arial, sans-serif" font-size="7" font-weight="700">V</text>
            </g>
            break;
        case CadIconName.RemoveDuplicates:
            <rect x="3" y="3" width="12" height="12" rx="1"/>
            <rect x="9" y="9" width="12" height="12" rx="1"/>
            <path d="m12 12 6 6m0-6-6 6"/>
            break;
    }
    }
</svg>

@code {
    [Parameter]
    public CadIconName Name { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "dxfer-icon"
        : $"dxfer-icon {Class}";
}
